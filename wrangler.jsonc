{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alterxyz-artifacts",
  "compatibility_date": "2026-10-27",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html"]
  },
  "routes": [
    { "pattern": "artifact.alterxyz.com", "custom_domain": true },
    { "pattern": "1120math.alterxyz.com", "custom_domain": true }
  ]
}
