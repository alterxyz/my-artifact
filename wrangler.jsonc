{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alterxyz-artifacts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "artifact.alterxyz.com", "custom_domain": true }
  ]
}
